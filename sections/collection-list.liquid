<section class="container sec">
  <div class="sec-head"><div><p class="eyebrow">Curated for you</p><h2>{{ section.settings.heading }}</h2></div><a href="/collections/all" class="link">View all →</a></div>
  <div class="cat-grid">
    {% for block in section.blocks %}
      <a href="{{ block.settings.link }}" class="cat-card">
        <div class="cat-img">{% if block.settings.image %}<img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title | escape }}">{% else %}<div class="cat-ph">{{ block.settings.emoji }}</div>{% endif %}<span class="cat-tag">{{ block.settings.tag }}</span></div>
        <b>{{ block.settings.title }}</b><small>{{ block.settings.count }}</small>
      </a>
    {% endfor %}
  </div>
</section>
{% schema %}
{"name":"Collection list","settings":[{"type":"text","id":"heading","label":"Heading","default":"Shop by Category"}],"blocks":[{"type":"category","name":"Category","settings":[
{"type":"text","id":"title","label":"Title","default":"Luxury Lawn"},
{"type":"text","id":"count","label":"Count label","default":"120+ styles"},
{"type":"text","id":"tag","label":"Tag","default":"BESTSELLER"},
{"type":"text","id":"emoji","label":"Emoji if no image","default":"👗"},
{"type":"image_picker","id":"image","label":"Image"},
{"type":"url","id":"link","label":"Link"}
]}],"presets":[{"name":"Collection list"}]}
{% endschema %}
