<section class="container sec">
  <div class="sec-head"><div><p class="eyebrow">Most loved</p><h2>{{ section.settings.heading }}</h2></div><a href="{{ collections[section.settings.collection].url }}" class="link">Shop all →</a></div>
  <div class="product-grid">
    {% assign coll = collections[section.settings.collection] %}
    {% if coll and coll.products.size > 0 %}
      {% for product in coll.products limit: section.settings.limit %}
        {% render 'product-card', product: product %}
      {% endfor %}
    {% else %}
      {% for i in (1..4) %}
      <div class="p-card">
        <div class="p-img"><span style="font-size:48px">{% cycle '👗','🧕','👚','👠' %}</span><span class="p-badge">NEW</span></div>
        <b>Sample Boutique Dress {{ i }}</b><small>Embroidered 3-Piece</small>
        <div class="p-price">$49.00 <s>$69.00</s></div>
        <a href="/collections/all" class="btn btn-dark btn-sm">View Product</a>
      </div>
      {% endfor %}
    {% endif %}
  </div>
</section>
{% schema %}
{"name":"Featured collection","settings":[
{"type":"text","id":"heading","label":"Heading","default":"This Week's Bestsellers"},
{"type":"collection","id":"collection","label":"Collection"},
{"type":"range","id":"limit","label":"Products to show","min":4,"max":12,"step":4,"default":8}
],"presets":[{"name":"Featured collection"}]}
{% endschema %}
