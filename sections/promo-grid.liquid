<section class="container sec">
  <div class="promo-grid">
    <div class="promo big"><small>{{ section.settings.tag1 }}</small><h3>{{ section.settings.title1 }}</h3><a href="/collections/all" class="btn btn-light">Shop Now →</a></div>
    <div class="promo pink"><small>{{ section.settings.tag2 }}</small><h3>{{ section.settings.title2 }}</h3><a href="/collections/all" class="link">Explore →</a></div>
    <div class="promo dark"><small>{{ section.settings.tag3 }}</small><h3>{{ section.settings.title3 }}</h3><a href="/collections/all" class="link" style="color:#fff">Explore →</a></div>
  </div>
</section>
{% schema %}
{"name":"Promo grid","settings":[
{"type":"text","id":"tag1","label":"Tag 1","default":"FLAT 30% OFF"},
{"type":"text","id":"title1","label":"Title 1","default":"Festive Edit — Luxury Pret"},
{"type":"text","id":"tag2","label":"Tag 2","default":"NEW"},
{"type":"text","id":"title2","label":"Title 2","default":"Abaya Collection"},
{"type":"text","id":"tag3","label":"Tag 3","default":"2 FOR $99"},
{"type":"text","id":"title3","label":"Title 3","default":"Everyday Lawn Essentials"}
],"presets":[{"name":"Promo grid"}]}
{% endschema %}
