<div class="p-card">
  <a href="{{ product.url }}" class="p-img">
    {% if product.featured_image %}
      <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy">
    {% else %}
      {{ 'product-1' | placeholder_svg_tag }}
    {% endif %}
    {% if product.compare_at_price > product.price %}<span class="p-badge sale">-{{ product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price }}%</span>
    {% else %}<span class="p-badge">NEW</span>{% endif %}
  </a>
  <a href="{{ product.url }}"><b>{{ product.title }}</b></a>
  <small>{{ product.type | default: 'Boutique Pret' }}</small>
  <div class="p-price">{{ product.price | money }}{% if product.compare_at_price > product.price %} <s>{{ product.compare_at_price | money }}</s>{% endif %}</div>
</div>
